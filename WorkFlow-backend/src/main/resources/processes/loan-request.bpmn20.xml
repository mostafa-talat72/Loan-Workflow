<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:activiti="http://activiti.org/bpmn" id="Definitions_0d6iojk" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.53.0">
  <bpmn:process id="loanRequest" name="Loan Request" isExecutable="true">
    <bpmn:startEvent id="start" name="Start">
      <bpmn:outgoing>toSubmit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="toSubmit" name="Start to submit" sourceRef="start" targetRef="submitApplication" />
    <bpmn:userTask id="submitApplication" name="Submitting a loan application" activiti:candidateGroups="CUSTOMER">
      <bpmn:incoming>toSubmit</bpmn:incoming>
      <bpmn:outgoing>fromSubmitToCreditCheck</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="fromSubmitToCreditCheck" name="From submit to credit check" sourceRef="submitApplication" targetRef="creditCheck" />
    <bpmn:serviceTask id="creditCheck" name="Automated credit check" activiti:delegateExpression="${creditCheckDelegate}">
      <bpmn:incoming>fromSubmitToCreditCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_12vajl8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="eligibilityGateway" name="Eligibility?&#10;creditScore ≥ 550" default="ineligible">
      <bpmn:incoming>Flow_12vajl8</bpmn:incoming>
      <bpmn:outgoing>ineligible</bpmn:outgoing>
      <bpmn:outgoing>eligible</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_12vajl8" sourceRef="creditCheck" targetRef="eligibilityGateway" />
    <bpmn:endEvent id="autoRejected" name="Automatically rejected">
      <bpmn:incoming>ineligible</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ineligible" name="Ineligible" sourceRef="eligibilityGateway" targetRef="autoRejected" />
    <bpmn:sequenceFlow id="eligible" name="Eligible" sourceRef="eligibilityGateway" targetRef="riskReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${creditScore &gt;= 550}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="riskReview" name="Risk Officer Review" activiti:candidateGroups="RISK_OFFICER">
      <bpmn:incoming>eligible</bpmn:incoming>
      <bpmn:outgoing>Flow_1ofcqsi</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="riskDecisionGateway" name="Risk-based decision?" default="unacceptableRisk">
      <bpmn:incoming>Flow_1ofcqsi</bpmn:incoming>
      <bpmn:outgoing>unacceptableRisk</bpmn:outgoing>
      <bpmn:outgoing>acceptableRisk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1ofcqsi" sourceRef="riskReview" targetRef="riskDecisionGateway" />
    <bpmn:endEvent id="rejectedByOfficer" name="Rejected by risk officer">
      <bpmn:incoming>unacceptableRisk</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="unacceptableRisk" name="reject" sourceRef="riskDecisionGateway" targetRef="rejectedByOfficer" />
    <bpmn:exclusiveGateway id="amountGateway" name="Amount &#62; 50,000?" default="amountLess50">
      <bpmn:incoming>acceptableRisk</bpmn:incoming>
      <bpmn:outgoing>amountLess50</bpmn:outgoing>
      <bpmn:outgoing>amountMore50</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="acceptableRisk" name="approved" sourceRef="riskDecisionGateway" targetRef="amountGateway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${officerDecision eq 'APPROVE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="amountLess50" name="Amount ≤ 50,000" sourceRef="amountGateway" targetRef="disburseLoan" />
    <bpmn:sequenceFlow id="amountMore50" name="Amount &#62; 50,000" sourceRef="amountGateway" targetRef="managerApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt; 50000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="disburseLoan" name="Disbursement of the loan" activiti:delegateExpression="${disburseDelegate}">
      <bpmn:incoming>amountLess50</bpmn:incoming>
      <bpmn:incoming>managerAcceptable</bpmn:incoming>
      <bpmn:outgoing>Flow_087mwij</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="managerApproval" name="Branch Manager Approval" activiti:candidateGroups="BRANCH_MANAGER">
      <bpmn:incoming>amountMore50</bpmn:incoming>
      <bpmn:outgoing>Flow_0pvh0n5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="rejectedByManager" name="Rejected by branch manager">
      <bpmn:incoming>managerRefused</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="managerDecisionGateway" name="The manager&#39;s decision?" default="managerRefused">
      <bpmn:incoming>Flow_0pvh0n5</bpmn:incoming>
      <bpmn:outgoing>managerRefused</bpmn:outgoing>
      <bpmn:outgoing>managerAcceptable</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0pvh0n5" sourceRef="managerApproval" targetRef="managerDecisionGateway" />
    <bpmn:sequenceFlow id="managerRefused" name="no" sourceRef="managerDecisionGateway" targetRef="rejectedByManager" />
    <bpmn:sequenceFlow id="managerAcceptable" name="yes" sourceRef="managerDecisionGateway" targetRef="disburseLoan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${managerDecision eq 'APPROVE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="approved" name="Approved">
      <bpmn:incoming>Flow_087mwij</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_087mwij" sourceRef="disburseLoan" targetRef="approved" />
  </bpmn:process>
