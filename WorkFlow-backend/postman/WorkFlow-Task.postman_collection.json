{
  "info": {
    "name": "WorkFlow-Task - Loan Request (Activiti)",
    "description": "End-to-end checks for the loan-request BPMN. Run folders in order (0 then 1..6) with the Collection Runner, or run 0 first and then any scenario manually. Requires the app on http://localhost:8085 with the seeded users (customer1/customer2/officer1/manager1, password Password@123). These requests write real rows (LOAN_APPLICATION + ACT_* history) to the configured Oracle schema.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8085" },
    { "key": "password", "value": "Password@123" },
    { "key": "customerToken", "value": "" },
    { "key": "customer2Token", "value": "" },
    { "key": "officerToken", "value": "" },
    { "key": "managerToken", "value": "" },
    { "key": "appIdS1", "value": "" },
    { "key": "appIdS2", "value": "" },
    { "key": "appIdS3", "value": "" },
    { "key": "appIdS4", "value": "" },
    { "key": "appIdS5", "value": "" },
    { "key": "appIdNeg", "value": "" }
  ],
  "item": [
    {
      "name": "0 - Login",
      "item": [
        {
          "name": "Login customer1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('token returned', () => pm.expect(b.token).to.be.a('string'));",
                  "pm.collectionVariables.set('customerToken', b.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"customer1\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login customer2",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('customer2Token', b.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"customer2\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login officer1",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('role is RISK_OFFICER', () => pm.expect(b.role).to.eql('RISK_OFFICER'));",
                  "pm.collectionVariables.set('officerToken', b.token);"
