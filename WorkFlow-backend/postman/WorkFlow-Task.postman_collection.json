    {
      "name": "1 - Auto reject (credit score 480)",
      "item": [
        {
          "name": "customer2 submits 20,000",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('appIdS1', b.id);",
                  "pm.test('status is REJECTED', () => pm.expect(b.status.code).to.eql('REJECTED'));",
                  "pm.test('no disbursement', () => pm.expect(b.disbursementRef).to.eql(null));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customer2Token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 20000,\n  \"termMonths\": 24,\n  \"purpose\": \"Auto reject scenario\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/loans", "host": ["{{baseUrl}}"], "path": ["loans"] }
          }
        },
        {
          "name": "customer2 reads own application",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('status is REJECTED', () => pm.expect(b.status.code).to.eql('REJECTED'));",
                  "pm.test('credit score copied', () => pm.expect(b.creditScore).to.eql(480));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customer2Token}}" }],
            "url": {
              "raw": "{{baseUrl}}/loans/{{appIdS1}}",
              "host": ["{{baseUrl}}"],
              "path": ["loans", "{{appIdS1}}"]
            }
          }
        }
      ]
    },
